{
  "name": "translation-workshop",
  "version": "1.0.5",
  "description": "Local translation and proofreading workflow workbench.",
  "type": "module",
  "main": "dist/main/main.js",
  "bin": {
    "translation-workshop-skills": "scripts/install-skills.mjs"
  },
  "scripts": {
    "prepare:xterm-assets": "node scripts/prepare-xterm-assets.mjs",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build:main": "npm run prepare:xterm-assets && esbuild src/main/main.ts --bundle --platform=node --format=esm --outfile=dist/main/main.js --external:electron --external:extract-zip --external:node-pty && npm run build:preload",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --format=cjs --outfile=dist/main/preload.cjs --external:electron",
    "dev": "concurrently -k -n renderer,electron \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:main && wait-on http://127.0.0.1:5173 && cross-env TRANSLATION_WORKSHOP_DEV=1 electron .",
    "build": "tsc && npm run build:main && vite build",
    "package:dir": "npm run build && cross-env ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --dir",
    "package:win": "npm run build && cross-env ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --win",
    "package:linux": "npm run build && cross-env ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --linux",
    "start": "electron ."
  },
  "keywords": [
    "translation",
    "proofreading",
    "local-first",
    "electron",
    "i18n"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "local.translation-workshop",
    "productName": "translation-workshop",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack-win.cjs",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "skills/**/*",
      "scripts/**/*",
      "README.md",
      "README.en.md",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/vendor/xterm",
        "to": "assets/vendor/xterm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "skills/**/*",
      "scripts/install-skills.mjs"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "assets/app-icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "dir"
      ]
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
